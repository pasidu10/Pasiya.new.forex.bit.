# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Exchange API Keys (Optional - for live trading)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# Channel & Group IDs
CHANNEL_ID=@your_channel_name
GROUP_ID=-1001234567890

# Premium Configuration
PREMIUM_CHANNEL_ID=@your_premium_channel
VIP_PRICE_MONTHLY=29.99
VIP_PRICE_YEARLY=299.99

# Admin Configuration
SUPER_ADMIN_ID=123456789

# Database - Supabase (Primary)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database - SQLite (Fallback for local development)
DATABASE_PATH=data/trading_bot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Market Configuration
DEFAULT_TIMEFRAME=1h
SUPPORTED_TIMEFRAMES=1m,5m,15m,1h,4h,1d

# Signal Configuration
AUTO_SIGNAL_INTERVAL=300
SIGNAL_EXPIRY_HOURS=24
MAX_DAILY_SIGNALS=10

# Alert Configuration
PRICE_CHECK_INTERVAL=60
ALERT_THRESHOLD_PERCENT=2.0

# News API (Optional)
NEWS_API_KEY=your_news_api_key

# Feature Flags
ENABLE_AUTO_SIGNALS=true
ENABLE_NEWS_ALERTS=true
ENABLE_PRICE_ALERTS=true

# Localization
DEFAULT_LANGUAGE=en
